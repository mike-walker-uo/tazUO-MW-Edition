<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>cuoicon.ico</ApplicationIcon>
    <AssemblyName>ClassicUO</AssemblyName>
    <RootNamespace>ClassicUO</RootNamespace>
    <AssemblyVersion>0.5</AssemblyVersion>
    <FileVersion>0.5</FileVersion>
    <PackageProjectUrl>https://github.com/PlayTazUO/TazUO</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>$(ProjectDir)..\..\bin\Release\</OutputPath>
    <PublishDir>$(ProjectDir)..\..\bin\dist\</PublishDir>
    <Optimize>true</Optimize>
    <!-- Windowed app: no console window for public builds. Debug keeps the
         console for live Trace/Error output. -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>$(ProjectDir)..\..\bin\Debug\</OutputPath>
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IS_DEV_BUILD)' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClassicUO.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.NetFramework.csproj" Condition="Exists('..\..\external\FNA\FNA.NetFramework.csproj')" />
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" Condition="!Exists('..\..\external\FNA\FNA.NetFramework.csproj')" />
    <ProjectReference Include="..\ClassicUO.Assets\ClassicUO.Assets.csproj" />
    <ProjectReference Include="..\ClassicUO.Renderer\ClassicUO.Renderer.csproj" />
    <ProjectReference Include="..\ClassicUO.Utility\ClassicUO.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ClassicUO.Assets\fonts\ChakraPetch-OFL.txt">
      <Link>licenses\ChakraPetch-OFL.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\ClassicUO.Assets\fonts\Official-Fonts-NOTICE.txt">
      <Link>licenses\Official-Fonts-NOTICE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\ResErrorMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResErrorMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResGeneral.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResGeneral.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResGumps.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResGumps.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ResErrorMessages.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResGeneral.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResGeneral.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResGumps.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResGumps.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <DataFiles_iplib Include="$(ProjectDir)..\..\external\iplib\**\*.*" />
    <DataFiles_x64 Include="$(ProjectDir)..\..\external\x64\*.*" />
    <DataFiles_lib64 Include="$(ProjectDir)..\..\external\lib64\*.*" />
    <DataFiles_osx Include="$(ProjectDir)..\..\external\osx\*.*" />
    <DataFiles_vulkan Include="$(ProjectDir)..\..\external\vulkan\icd.d\*.*" />
  </ItemGroup>

  <Target Name="CompileWaterShader"
          BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT'"
          Inputs="$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fx"
          Outputs="$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fxc">
    <Exec Command="&quot;$(ProjectDir)..\ClassicUO.Renderer\shaders\fxc.exe&quot; /T fx_2_0 /O3 /Fo &quot;$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fxc&quot; &quot;$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fx&quot;" />
  </Target>

  <ItemGroup>
    <None Remove="Game\Managers\DefaultSpellIndicatorConfig.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Game\Managers\DefaultSpellIndicatorConfig.json" />
    <EmbeddedResource Include="Resources\WorldExplorer\classic-panel.png" />
    <EmbeddedResource Include="Resources\WorldExplorer\classic-button.png" />
    <EmbeddedResource Include="Resources\OrnateTheme\panel.png" />
    <EmbeddedResource Include="Resources\BritannianChronicle\panel.png" />
    <EmbeddedResource Include="Resources\BritannianChronicle\button.png" />
    <EmbeddedResource Include="Resources\MoonglowArcane\panel.png" />
    <EmbeddedResource Include="Resources\MoonglowArcane\button.png" />
    <EmbeddedResource Include="Resources\TerMurRelic\panel.png" />
    <EmbeddedResource Include="Resources\TerMurRelic\button.png" />
    <EmbeddedResource Include="Resources\MarinersChart\panel.png" />
    <EmbeddedResource Include="Resources\MarinersChart\button.png" />
    <EmbeddedResource Include="Resources\GildedGroveTheme\panel.png" />
    <EmbeddedResource Include="Resources\GildedGroveTheme\button.png" />
    <EmbeddedResource Include="Resources\AetherglassTheme\panel.png" />
    <EmbeddedResource Include="Resources\AetherglassTheme\button.png" />
    <EmbeddedResource Include="Resources\Runestone\sheet.png" />
    <EmbeddedResource Include="Resources\OakAndIron\sheet.png" />
    <EmbeddedResource Include="Resources\HeartwoodSanctuary\sheet.png" />
    <EmbeddedResource Include="Resources\Celestial\sheet.png" />
    <EmbeddedResource Include="Resources\Exodus\sheet.png" />
    <EmbeddedResource Include="Resources\BloodOath\sheet.png" />
    <EmbeddedResource Include="Resources\NecromancersCrypt\sheet.png" />
    <EmbeddedResource Include="Resources\Hildebrandt\sheet.png" />
    <EmbeddedResource Include="Resources\BossHealthBar\ornate-frame.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IronPython" Version="3.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="cuoapi">
      <HintPath>..\..\external\cuoapi\cuoapi.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>..\..\..\..\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2\System.Net.Http.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms">
      <HintPath>..\..\..\..\..\..\..\..\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2\System.Windows.Forms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <DocSourceFiles Include="$(ProjectDir)/LegionScripting/PyClasses/*.cs" />
    <DocSourceFiles Include="$(ProjectDir)/LegionScripting/API.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Create a string of quoted paths -->
    <DocFileArgs>@(DocSourceFiles->'"%(FullPath)"', ' ')</DocFileArgs>
  </PropertyGroup>

<!--  <Target Name="GenerateDocs" AfterTargets="Build">
    <Message Text="Running: dotnet run &#45;&#45;project ../APIToMarkdown/APIToMarkdown.csproj $(DocFileArgs)" />
    <Exec Command='dotnet run &#45;&#45;project ../APIToMarkdown/APIToMarkdown.csproj "$(ProjectDir)/LegionScripting/docs" $(DocFileArgs)' />
  </Target>-->

  <Target Name="CreateVersionFile" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)v.txt" Lines="$(AssemblyVersion)" Overwrite="true" />
  </Target>

  <Target Name="CopyExternalDeps_build" AfterTargets="Build">
    <ItemGroup>
      <MonockickstartPath Include="$(ProjectDir)..\..\tools\monokickstart\*.*" />
      <WaterShader Include="$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fxc" Condition="Exists('$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fxc')" />
    </ItemGroup>

    <Copy SourceFiles="@(DataFiles_iplib)" DestinationFiles="@(DataFiles_iplib -> '$(TargetDir)\iplib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(TargetDir)\x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(TargetDir)\lib64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(TargetDir)\osx\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_vulkan)" DestinationFolder="$(TargetDir)\vulkan\icd.d\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WaterShader)" DestinationFolder="$(TargetDir)\" SkipUnchangedFiles="true" Condition="'@(WaterShader)' != ''" />

    <Copy SourceFiles="@(MonockickstartPath)" DestinationFolder="$(TargetDir)\" SkipUnchangedFiles="true" Condition="$(TargetFramework.StartsWith('net4'))" />
  </Target>

  <Target Name="CreateVersionFile_publish" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)v.txt" Lines="$(AssemblyVersion)" Overwrite="true" />
  </Target>

  <Target Name="CopyExternalDeps_publish" AfterTargets="Publish">
    <ItemGroup>
      <MonockickstartPath Include="$(ProjectDir)..\..\tools\monokickstart\*.*" />
      <WaterShader Include="$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fxc" Condition="Exists('$(ProjectDir)..\ClassicUO.Renderer\shaders\Water.fxc')" />
    </ItemGroup>

    <Copy SourceFiles="@(DataFiles_iplib)" DestinationFiles="@(DataFiles_iplib -> '$(PublishDir)\iplib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(PublishDir)\x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(PublishDir)\lib64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(PublishDir)\osx\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles_vulkan)" DestinationFolder="$(PublishDir)\vulkan\icd.d\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WaterShader)" DestinationFolder="$(PublishDir)\" SkipUnchangedFiles="true" Condition="'@(WaterShader)' != ''" />

    <Copy SourceFiles="@(MonockickstartPath)" DestinationFolder="$(PublishDir)\" SkipUnchangedFiles="true" Condition="$(TargetFramework.StartsWith('net4'))" />
  </Target>

</Project>
